{
  "name": "pi-ghostty-native-editor",
  "version": "0.1.1",
  "description": "macOS-style text editing for the pi coding agent prompt in Ghostty: selection with Shift+arrows and mouse, Cmd+C/X/V/Z/A, redo, and optional Enter/Shift+Enter swap",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "ghostty",
    "editor",
    "macos"
  ],
  "license": "MIT",
  "author": "Kaspars Dancis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k7d/pi-ghostty-native-editor.git"
  },
  "homepage": "https://github.com/k7d/pi-ghostty-native-editor#readme",
  "type": "module",
  "files": [
    "extensions",
    "ghostty.conf",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/ghostty-native-editor.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
